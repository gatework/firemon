      "set rulebase security rules apps to untrust",
      "set rulebase security rules apps source lan",
      "set rulebase security rules apps destination any",
      "set rulebase security rules apps application [ ssl web-browsing ]",
      "set rulebase security rules apps service application-default",
      "set rulebase security rules apps action allow"
    ],
    "rule:block-bad": [
      "set rulebase security rules block-bad from untrust",
      "set rulebase security rules block-bad to any",
      "set rulebase security rules block-bad source 192.0.2.0/24",
      "set rulebase security rules block-bad destination any",
      "set rulebase security rules block-bad application any",
      "set rulebase security rules block-bad service any",
      "set rulebase security rules block-bad action drop"
    ],
    "rule:not-lan": [
      "set rulebase security rules not-lan from trust",
      "set rulebase security rules not-lan to untrust",
      "set rulebase security rules not-lan source lan",
      "set rulebase security rules not-lan negate-source yes",
      "set rulebase security rules not-lan destination any",
      "set rulebase security rules not-lan service dns-udp",
      "set rulebase security rules not-lan action deny",
      "set rulebase security rules not-lan disabled yes",
      "set rulebase security rules not-lan schedule office"
    ],
    "rule:web-in": [
      "set rulebase security rules web-in from untrust",
      "set rulebase security rules web-in to dmz",
      "set rulebase security rules web-in source any",
      "set rulebase security rules web-in destination public-web",
      "set rulebase security rules web-in application any",
      "set rulebase security rules web-in service web",
      "set rulebase security rules web-in action allow",
      "set rulebase security rules web-in log-end yes"
    ],
    "schedule:change-window": [
      "set schedule change-window schedule-type non-recurring 2026/11/01@00:00-2026/12/01@00:00"
    ],
    "schedule:office": [
      "set schedule office schedule-type recurring weekly monday [ 08:00-18:00 ]"
    ],
