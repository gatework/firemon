# commands
set address Net_10.0.5.0_24 ip-netmask 10.0.5.0/24
set address Net_172.16.0.40_31 ip-netmask 172.16.0.40/31
set service TCP_8000-8010 protocol tcp port 8000-8010
set service TCP_8443 protocol tcp port 8443
set rulebase security rules req-42 from trust
set rulebase security rules req-42 to dmz
set rulebase security rules req-42 source Net_10.0.5.0_24
set rulebase security rules req-42 destination Net_172.16.0.40_31
set rulebase security rules req-42 application any
set rulebase security rules req-42 service [ TCP_8000-8010 TCP_8443 ]
set rulebase security rules req-42 action allow
set rulebase security rules req-42 description "ticket 42"
# rollback
delete rulebase security rules req-42
delete service TCP_8443
delete service TCP_8000-8010
delete address Net_172.16.0.40_31
delete address Net_10.0.5.0_24
